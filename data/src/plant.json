  "sis": {
    "en": "Safety instrumented system",
    "ar": "نظام السلامة المزود بالأجهزة",
    "abbr": "SIS",
    "esd_en": "Emergency shutdown",
    "esd_ar": "الإيقاف الطارئ",
    "guards": [
      "mr_pressure",
      "tank_pressure"
    ],
    "desc": {
      "en": "The safety system watches the refrigerant pressure and the tank pressure, and on a high reading it trips an emergency shutdown that closes valves and routes gas to the flare so pressure falls safely.",
      "ar": "يراقب نظام السلامة ضغط المبرّد وضغط الخزان وعند ارتفاع القراءة يشغّل إيقافًا طارئًا يغلق الصمامات ويوجه الغاز إلى الشعلة حتى يهبط الضغط بأمان."
    }
